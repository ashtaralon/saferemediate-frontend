FROM node:24.20.0-alpine3.24@sha256:e67514e5d0f6c46656005e1b693b2ec9d52e80b641307de684d4a015ba7a4eaf AS build
WORKDIR /app
ENV NEXT_TELEMETRY_DISABLED=1
ENV CYNTRO_DEPLOYMENT_MODE=CUSTOMER_RESIDENT
COPY package.json package-lock.json ./
RUN npm ci
COPY . .
RUN node scripts/prepare-customer-image.mjs
RUN npm run build -- --webpack
RUN ! grep -R -q -F "saferemediate-backend-f.onrender.com" .next/server
RUN npm prune --omit=dev

FROM gcr.io/distroless/nodejs24-debian13:nonroot@sha256:774b7d020b24214835769e24c3544835526cd0288f0b094eae48e8b2c2429a79 AS runtime
WORKDIR /app
ENV NODE_ENV=production
ENV NEXT_TELEMETRY_DISABLED=1
ENV CYNTRO_DEPLOYMENT_MODE=CUSTOMER_RESIDENT
ENV HOSTNAME=0.0.0.0
ENV PORT=3000
COPY --from=build --chown=nonroot:nonroot /app/.next/standalone ./
COPY --from=build --chown=nonroot:nonroot /app/.next/static ./.next/static
COPY --from=build --chown=nonroot:nonroot /app/public ./public
USER nonroot
EXPOSE 3000
CMD ["server.js"]
