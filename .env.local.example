# Backend URL - MUST be set in Vercel Environment Variables
NEXT_PUBLIC_BACKEND_URL=https://saferemediate-backend.onrender.com
# OR
NEXT_PUBLIC_API_URL=https://saferemediate-backend.onrender.com

# Free-form Analyst remains disabled unless BOTH of these are deliberately
# configured in a customer-resident deployment behind the OIDC-authenticated
# private ALB. Never use "*" for the allowed systems.
CYNTRO_DEPLOYMENT_MODE=HOSTED
# CYNTRO_ANALYST_ALLOWED_SYSTEMS=payments,shared-services

# Required secrets are checked at startup (lib/server/deployment-config.ts); the
# server refuses to start, naming what is missing, rather than failing later.
#
# HOSTED: the console is gated by a sealed site session issued at /api/auth/login.
#   SITE_PASSWORD                 required -- sign-in always checks it
#   CYNTRO_SITE_SESSION_SECRET    optional sealing key; if set, 32+ characters, or it
#                                 would be ignored. Without it the key is derived
#                                 from SITE_PASSWORD.
# CUSTOMER_RESIDENT: users are authenticated by the private ALB's OIDC action.
#   CYNTRO_SERVICE_TOKEN          required -- server-side backend service token
#   BACKEND_URL_OVERRIDE          required -- this install's own backend
#
# Never put a real value in this file.
# SITE_PASSWORD=
# CYNTRO_SITE_SESSION_SECRET=
# CYNTRO_SERVICE_TOKEN=
# BACKEND_URL_OVERRIDE=
